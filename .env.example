# Пример конфигурации (НЕ вставляйте реальные токены в репозиторий)

# Токен бота от @BotFather
BOT_TOKEN=PASTE_YOUR_TOKEN_HERE

# ID админов через запятую (узнать ID: @userinfobot)
ADMIN_IDS=123456789

# ID менеджеров через запятую
MANAGER_IDS=

# База данных (по умолчанию SQLite в ./data/seobot.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/seobot.db

# Прокси (опционально)
PROXY_URL=

# Напоминания админам
REVIEW_REMINDER_AFTER_MINUTES=1
REVIEW_SCHEDULER_INTERVAL_MINUTES=1

# Как часто проверять напоминания исполнителям (после оплаты отзыва)
EXECUTOR_REMINDER_INTERVAL_MINUTES=5

# Через сколько минут закрывать попытку, если исполнитель не прислал скрин отзыва
TASK_EXECUTION_TIMEOUT_MINUTES=60

# Приветственный бонус новым пользователям
WELCOME_BONUS_AMOUNT=20
WELCOME_BONUS_START_DATE=2026-05-16

