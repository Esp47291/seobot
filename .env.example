# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID админов через запятую (узнать ID: @userinfobot)
ADMIN_IDS=123456789

# База данных (по умолчанию SQLite в ./data/seobot.db)
# DATABASE_URL=sqlite+aiosqlite:///./data/seobot.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Лимиты заданий (часы)
YANDEX_COOLDOWN_HOURS=24
TWOGIS_COOLDOWN_HOURS=2

# Количество шагов обучения (1-4 сообщения)
TRAINING_STEPS=4
